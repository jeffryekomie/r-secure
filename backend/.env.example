# Port de l'API
PORT=4000

# Secret pour signer les tokens JWT (générez une longue chaîne aléatoire en production)
JWT_SECRET=change_this_secret_before_deploying

# Fichier de base de données SQLite
DB_PATH=./data/rtlconnect.db

# Chaque routeur est joint directement via son adresse VPN (vpn_ip), stockée
# par routeur en base au moment de son enregistrement (POST /routers).
# Voir backend/vpn/README.md pour la mise en place du serveur VPN (OpenVPN,
# confirmé compatible avec le VPN Client du ZLT W154R Plus).
