# Port de l'API
PORT=4000

# OBLIGATOIRES : le serveur refuse de démarrer sans elles
JWT_SECRET=remplacez_par_32_caracteres_aleatoires_minimum
ADMIN_KEY=remplacez_par_une_cle_admin_longue
APP_PRICE=910

# Commission de parrainage en % du prix payé par le filleul
COMMISSION_PERCENT=20

# Fichier de base de données SQLite
DB_PATH=./data/rtlconnect.db

# Changement de téléphone en libre-service : nombre autorisé par fenêtre (0 = jamais, seul l'admin peut délier)
DEVICE_REBIND_MAX=2
DEVICE_REBIND_DAYS=30

# Code pays par défaut pour normaliser les numéros (Gabon = 241)
DEFAULT_COUNTRY_CODE=241

# Chemin de l'APK servi après paiement (défaut : backend/data/app.apk)
# APK_PATH=

# Ne JAMAIS mettre false en production (inscription libre sans code)
# LICENSE_REQUIRED=true
